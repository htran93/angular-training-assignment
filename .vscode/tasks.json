{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Family Finance API",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"${workspaceFolder}\\backend\\FamilyFinance.Api\\FamilyFinance.Api.csproj",
				"--launch-profile",
				"FamilyFinance.Api"
			],
			"options": {
				"env": {
					"PATH": "${env:USERPROFILE}\\.dotnet;${env:PATH}"
				}
			},
			"isBackground": true
		}
	]
}